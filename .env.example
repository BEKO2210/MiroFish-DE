# ===========================================
# MiroFish – Einstellungen
# Die meisten Werte lassen sich in der App unter „Einstellungen“ ändern.
# ===========================================

# Sprachmodell: 'ollama' (empfohlen, lokal), 'lmstudio', 'local' (anderer OpenAI-kompatibler Server) oder 'openai'
LLM_PROVIDER=ollama

# Lokaler Modellserver (Ollama)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL_NAME=gemma4:12b-it-qat        # Hauptmodell: liest Dokumente, schreibt den Bericht
LOCAL_LLM_API_KEY=

# Agentenmodell für die Simulation (bei lokalem Betrieb derselbe Server, gern ein kleineres Modell)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=gemma4:e4b-it-qat
LLM_API_KEY=

# Für OpenAI stattdessen:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_KEY=sk-...

# Gedächtnis der Agenten: 'obsidian' (lokal, kein Konto nötig), 'zep' oder 'hybrid'
MEMORY_PROVIDER=obsidian
# ZEP_API_KEY=            # nur für zep/hybrid

# Server
FLASK_PORT=5001
FLASK_DEBUG=false         # der Reloader würde laufende Simulationen beenden
MIROFISH_PORT=5001        # Host-Port für Docker; Bindung bleibt auf 127.0.0.1
# MIROFISH_UID=1000       # optional: scripts/start.sh nutzt sonst automatisch `id -u`
# MIROFISH_GID=1000       # optional: scripts/start.sh nutzt sonst automatisch `id -g`
# API_TOKEN=              # wenn gesetzt, verlangt die API "Authorization: Bearer <token>"
# CORS_ORIGINS=http://localhost:3000  # optional, kommasepariert; niemals "*". Nötig im Vite-Dev-Modus
#                                     (Frontend :3000 -> API :5002/:5001); Produktion läuft same-origin.
